# Copy to .env and fill in. .env is gitignored.
#
# Token for the Anthropic Enterprise/Admin Analytics API.
# This org accepts a standard key via the x-api-key header; an OAuth token
# with the read:analytics scope (minted at claude.ai/analytics/api-keys) also works.
ANTHROPIC_ANALYTICS_TOKEN=sk-ant-...

# Optional overrides
# ANTHROPIC_ANALYTICS_BASE=https://api.anthropic.com/v1/organizations/analytics
# ANTHROPIC_VERSION=2023-06-01
# BILLING_DB=./data/analytics.db

# ---------------------------------------------------------------------------
# Receiver auth — shared fleet token required on every write (POST) to the
# receiver. Must match CLAUDE_BILLING_TOKEN / OTEL_EXPORTER_OTLP_HEADERS pushed
# to dev machines (deploy/managed-settings.json). Leave blank to run the
# receiver OPEN (it warns loudly at startup); set it, then start the receiver
# with --require-auth, to enforce. Generate one with: openssl rand -hex 32
RECEIVER_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Billing scope — which accounts the receiver will record usage for.
#
# Telemetry config is deployed per MACHINE, so it applies to whichever Claude
# account is signed in — including a developer's personal Pro/Max account on a
# work laptop. That usage carries a personal email into the store and the data
# lake, and carries cost Cyclotron never paid onto a client invoice. Datapoints
# from accounts outside this scope are REFUSED AT INGEST (never stored); only an
# aggregate count per domain survives, in the scope_rejections table.
#
# This is a hygiene control, not a security boundary — these are self-reported
# OTEL attributes. The control that actually PREVENTS a personal login is
# forceLoginOrgUUID in deploy/managed-settings.json. See deploy/README.md §5.
#
# Anthropic organization UUID(s), comma-separated. The STRONG signal: a personal
# account has a different org even when its email is a work address. Find it at
# claude.ai/admin-settings/organization. Blank = not enforced (receiver warns).
BILLING_ALLOWED_ORG_IDS=
# Email domain(s), comma-separated. Defaults to cyclotron.com when unset.
# Set both blank to disable scope filtering entirely (accepts every account).
BILLING_ALLOWED_EMAIL_DOMAINS=cyclotron.com

# ---------------------------------------------------------------------------
# Data-lake sync — ship invoice CSVs to ADLS Gen2 (or OneLake) daily.
# Leave blank to disable (invoice.py then just writes local CSVs).
# ---------------------------------------------------------------------------
SYNC_TARGET=adls                 # adls | onelake
SYNC_AUTH=sp                     # sp (service principal) | msi (managed identity) | sas
SYNC_FREQUENCY=daily             # how often to push: hourly | daily | weekly | monthly

# --- ADLS Gen2 target (from your Azure Storage admin) ---
ADLS_ACCOUNT=                    # storage account NAME only, e.g. cyclotronbilling
ADLS_CONTAINER=                  # container / filesystem, e.g. landing
ADLS_PREFIX=claude-billing       # folder inside the container; files go under <prefix>/<period>/
# ADLS_API=blob                  # blob (default) | dfs. Keep 'blob' if the account has
#                                #   soft-delete/change-feed on (dfs endpoint rejects those).
# ADLS_ENDPOINT_SUFFIX=core.windows.net   # change only for sovereign clouds

# --- OneLake target (only if SYNC_TARGET=onelake) ---
# ONELAKE_WORKSPACE=             # Fabric workspace name or GUID
# ONELAKE_LAKEHOUSE=             # Lakehouse name (without the .Lakehouse suffix)
# ONELAKE_PREFIX=billing         # folder under the Lakehouse's Files/

# --- Auth (SYNC_AUTH=sp) — Entra service principal with write access to the container ---
AZURE_TENANT_ID=                 # tenant that owns the storage account
AZURE_CLIENT_ID=                 # app (client) ID   (also used as the user-assigned MI id)
AZURE_CLIENT_SECRET=             # client secret value
# AZURE_SAS_TOKEN=               # instead of the SP, if SYNC_AUTH=sas (no leading '?')
